// Merged .gitignore combining local project and app folder ignores

# dependencies
node_modules/
app/node_modules/

# Next.js
.next/
app/.next/
out/
app/out/

# Vercel
.vercel/
app/.vercel/

# env / secrets
.env
.env.*
app/.env
app/.env.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Local-only archives, backups, and reference material
archives/
archives/checkpoints/
archive/
app-checkpoint-*/
*-checkpoint-*/
*.zip
*.bak
*.backup
*.tmp

# Private/internal planning and operational notes
docs/operations/
docs/integration/
docs/1/
docs/resources/

# Raw local prompt-pack exports and agent transcripts
*prompt packs*.txt

# Raw Avance KB exports stay local-only
docs/Avance KB_s/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
